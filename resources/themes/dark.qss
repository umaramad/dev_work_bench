/* Generated by scripts/export_themes.py — edit ui/theme.py instead. */

* { outline: 0; }

QMainWindow, QDialog { background: #16171c; }
QWidget { color: #e3e7ef; font-size: 13px; }
QToolTip { background: #23262e; color: #e3e7ef; border: 1px solid #3b4150;
           padding: 4px 8px; border-radius: 4px; }

/* ---------- menu bar & menus ---------- */
QMenuBar { background: #1b1d23; color: #a4adbd;
           border-bottom: 1px solid #2c303a; padding: 2px 6px; }
QMenuBar::item { padding: 4px 10px; border-radius: 5px; background: transparent; }
QMenuBar::item:selected { background: rgba(91, 141, 239, 0.16); color: #e3e7ef; }
QMenu { background: #23262e; color: #e3e7ef; border: 1px solid #3b4150;
        padding: 6px; border-radius: 6px; }
QMenu::item { padding: 5px 24px 5px 12px; border-radius: 4px; }
QMenu::item:selected { background: rgba(91, 141, 239, 0.16); }
QMenu::item:disabled { color: #6d7686; }
QMenu::separator { height: 1px; background: #2c303a; margin: 5px 8px; }

/* ---------- toolbar ---------- */
QToolBar { background: #1b1d23; border: none;
           border-bottom: 1px solid #2c303a; padding: 3px 8px; spacing: 2px; }
QToolBar::separator { width: 1px; background: #2c303a; margin: 5px 8px; }
QToolButton { background: transparent; border: none; border-radius: 6px;
              padding: 4px; color: #a4adbd; }
QToolButton:hover { background: #262a32; color: #e3e7ef; }
QToolButton:pressed { background: rgba(91, 141, 239, 0.16); }
QToolButton:checked { background: rgba(91, 141, 239, 0.16); color: #e3e7ef; }
QToolButton:disabled { color: #6d7686; }
QToolButton#navItem { text-align: left; padding: 7px 9px; border-radius: 7px;
                      color: #a4adbd; font-size: 13px; }
QToolButton#navItem:hover { background: #262a32; color: #e3e7ef; }
QToolButton#navItem:checked { background: rgba(91, 141, 239, 0.16); color: #e3e7ef; }
QToolButton#chip { border: 1px solid #3b4150; border-radius: 12px;
                   padding: 3px 11px; color: #a4adbd; }
QToolButton#chip:hover { background: #262a32; color: #e3e7ef; }
QToolButton#chip:checked { background: rgba(91, 141, 239, 0.16); color: #e3e7ef;
                           border-color: #5b8def; }

/* ---------- status bar ---------- */
QStatusBar { background: #1b1d23; border-top: 1px solid #2c303a;
             color: #a4adbd; }
QStatusBar::item { border: none; }
QStatusBar QLabel { color: #a4adbd; padding: 0 6px; font-size: 12px; }

/* ---------- docks ---------- */
QDockWidget { color: #a4adbd; font-size: 12px; }
QDockWidget::title { background: #1f2126; color: #a4adbd;
                     border-bottom: 1px solid #2c303a; padding: 5px 10px;
                     text-align: left; font-weight: 600; }
QDockWidget::close-button, QDockWidget::float-button { border-radius: 4px;
                     padding: 2px; background: transparent; }
QDockWidget::close-button:hover, QDockWidget::float-button:hover {
                     background: #262a32; }

/* ---------- tabs ---------- */
QTabWidget::pane { border: none; background: #16171c; }
QTabBar { background: #1b1d23; }
QTabBar::tab { background: transparent; color: #a4adbd; padding: 7px 14px;
               border: none; border-bottom: 2px solid transparent; }
QTabBar::tab:hover { color: #e3e7ef; }
QTabBar::tab:selected { color: #e3e7ef; border-bottom: 2px solid #5b8def; }
QTabBar::tab:disabled { color: #6d7686; }

/* ---------- splitters ---------- */
QSplitter::handle { background: #16171c; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }
QSplitter::handle:hover { background: #5b8def; }
QSplitter::handle:pressed { background: #5b8def; }

/* ---------- trees / lists / tables ---------- */
QTreeWidget, QListWidget, QTableWidget {
    background: #1f2126; alternate-background-color: #16171c;
    border: 1px solid #2c303a; border-radius: 6px; }
QTreeWidget::item, QListWidget::item, QTableWidget::item { padding: 3px 6px; }
QTreeWidget::item:hover, QListWidget::item:hover { background: #262a32; }
QTreeWidget::item:selected, QListWidget::item:selected,
QTableWidget::item:selected { background: rgba(91, 141, 239, 0.16); color: #e3e7ef; }
QTreeWidget::branch { background: transparent; }
QHeaderView::section { background: #1f2126; color: #a4adbd; border: none;
    border-bottom: 1px solid #2c303a; padding: 5px 8px; font-weight: 600; }
QTableWidget { gridline-color: #2c303a; }
QTableCornerButton::section { background: #1f2126; border: none; }
QAbstractItemView { outline: 0; selection-background-color: rgba(91, 141, 239, 0.35); }

/* ---------- inputs ---------- */
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox {
    background: #14151a; border: 1px solid #3b4150; border-radius: 6px;
    padding: 5px 8px; selection-background-color: #5b8def; }
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus { border-color: #5b8def; }
QLineEdit[class="search"] { padding-left: 26px; }
QComboBox { background: #14151a; border: 1px solid #3b4150;
            border-radius: 6px; padding: 5px 10px; }
QComboBox:focus { border-color: #5b8def; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox::down-arrow { image: none; width: 0; height: 0; }
QComboBox QAbstractItemView { background: #23262e; border: 1px solid #3b4150;
    selection-background-color: rgba(91, 141, 239, 0.16); selection-color: #e3e7ef; }

/* ---------- buttons ---------- */
QPushButton { background: #262a32; color: #e3e7ef; border: 1px solid #3b4150;
              border-radius: 6px; padding: 5px 14px; }
QPushButton:hover { background: #2c313b; border-color: #6d7686; }
QPushButton:pressed { background: #4a7cdb; color: #ffffff; }
QPushButton:disabled { color: #6d7686; background: #1f2126; border-color: #2c303a; }
QPushButton[class="primary"] { background: #5b8def; color: #ffffff;
              border: 1px solid #5b8def; font-weight: 600; }
QPushButton[class="primary"]:hover { background: #709df6; border-color: #709df6; }
QPushButton[class="primary"]:pressed { background: #4a7cdb; }
QPushButton[class="ghost"] { background: transparent; border: 1px solid transparent;
              color: #a4adbd; }
QPushButton[class="ghost"]:hover { background: #262a32; color: #e3e7ef; }
QPushButton[class="danger"] { background: transparent; border: 1px solid transparent;
              color: #e06c6c; }
QPushButton[class="danger"]:hover { background: rgba(224, 108, 108, 0.12); }

/* ---------- scrollbars ---------- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #3a4050; border-radius: 4px;
                             min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #525b6f; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #3a4050; border-radius: 4px;
                              min-width: 24px; }
QScrollBar::handle:horizontal:hover { background: #525b6f; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ---------- progress / sliders ---------- */
QProgressBar { background: #262a32; border: 1px solid #2c303a;
               border-radius: 4px; text-align: center; color: #a4adbd;
               font-size: 11px; }
QProgressBar::chunk { background: #5b8def; border-radius: 3px; }
QSlider::groove:horizontal { height: 4px; background: #262a32;
                             border-radius: 2px; }
QSlider::handle:horizontal { background: #5b8def; width: 14px; height: 14px;
                             margin: -5px 0; border-radius: 7px; }

/* ---------- checkboxes / radios / groups ---------- */
QCheckBox, QRadioButton { spacing: 7px; color: #e3e7ef; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; }
QCheckBox::indicator { border: 1px solid #3b4150; border-radius: 4px;
                       background: #14151a; }
QCheckBox::indicator:hover { border-color: #5b8def; }
QCheckBox::indicator:checked { background: #5b8def; border-color: #5b8def; }
QRadioButton::indicator { border: 1px solid #3b4150; border-radius: 8px;
                          background: #14151a; }
QRadioButton::indicator:checked { border: 5px solid #5b8def;
                                  background: #14151a; }
QGroupBox { border: 1px solid #2c303a; border-radius: 8px;
            margin-top: 14px; padding-top: 8px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px;
                   color: #a4adbd; font-weight: 500; }

/* ---------- custom frames & bubbles ---------- */
QFrame#panel { background: #1f2126; border: 1px solid #2c303a;
               border-radius: 8px; }
QFrame#panelFlat { background: #1f2126; }
QFrame#chatUser { background: #3a5fae; border-radius: 10px;
                  border-bottom-right-radius: 2px; }
QFrame#chatAi { background: #262a32; border: 1px solid #3b4150;
                border-radius: 10px; border-bottom-left-radius: 2px; }
QLabel#sectionTitle { font-size: 15px; font-weight: 700; color: #e3e7ef; }
QLabel#muted { color: #a4adbd; }
QLabel#tiny { color: #6d7686; font-size: 11px; }
QLabel#hint { color: #6d7686; font-size: 11px; }
QLabel#statusPill { background: #262a32; border: 1px solid #3b4150;
                    border-radius: 10px; padding: 2px 9px; font-size: 11px; }
QLabel#statusPill[state="ok"] { color: #4cc38a; }
QLabel#statusPill[state="warn"] { color: #e2a94f; }
QLabel#statusPill[state="err"] { color: #e06c6c; }
QLabel#levelTrace { color: #6d7686; }
QLabel#levelDebug { color: #5cc8d6; }
QLabel#levelInfo { color: #a4adbd; }
QLabel#levelWarn { color: #e2a94f; }
QLabel#levelError { color: #e06c6c; }
